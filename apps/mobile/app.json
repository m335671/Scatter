{
  "expo": {
    "name": "Keep Runni'n",
    "slug": "keep-runnin",
    "scheme": "keeprunnin",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#121111",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.m335671.keeprunnin",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.m335671.keeprunnin",
      "adaptiveIcon": {
        "backgroundColor": "#EE2E14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ta position sert à te placer sur la carte de la partie.",
          "locationAlwaysAndWhenInUsePermission": "Pendant une partie, ton téléphone est dans ta poche : choisis « Toujours » pour que ta position continue d'être envoyée écran éteint.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner le QR code d'un fugitif pour l'attraper.",
          "microphonePermission": "Le micro sert à envoyer des messages vocaux dans la radio.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#121111"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
