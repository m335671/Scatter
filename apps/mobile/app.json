{
  "expo": {
    "name": "Keep Runni'n",
    "slug": "keep-runnin",
    "scheme": "keeprunnin",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#121111",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.m335671.keeprunnin"
    },
    "android": {
      "package": "com.m335671.keeprunnin",
      "adaptiveIcon": {
        "backgroundColor": "#EE2E14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ta position sert à te placer sur la carte de la partie.",
          "locationAlwaysAndWhenInUsePermission": "Pendant une partie, ton téléphone est dans ta poche : la position doit continuer d'être envoyée écran éteint.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner le QR code d'un fugitif pour l'attraper.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
